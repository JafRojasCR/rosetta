PORT=3000
MONGODB_URI=mongodb://localhost:27017/rosetta
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=7d
APP_BASE_URL=https://rosetta.jafrojas.com
NODE_ENV=development
DEBUG_OCR=false
TESSERACT_CORE_PATH=https://cdn.jsdelivr.net/npm/tesseract.js-core@5.1.1/tesseract-core.wasm.js
UPLOAD_DIR=uploads
CLASS_UPLOAD_MAX_FILE_SIZE_MB=4096
DOCUMENT_UPLOAD_MAX_FILE_SIZE_MB=4096
DOCUMENT_UPLOAD_CHUNK_SIZE_MB=4

# Google Cloud Storage (signed URLs)
STORAGE_PROVIDER=gcs
GCS_ENABLED=true
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_CREDENTIALS_BASE64=
STORAGE_SIGNED_URL_EXPIRY_SECONDS=900
STORAGE_SIGNED_UPLOAD_EXPIRY_SECONDS=900
GCS_DOCUMENTS_PREFIX=documents
GCS_CLASSES_PREFIX=classes
GCS_PAYMENTS_PREFIX=payments

# Google Drive upload (OAuth)
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLASSES_VIDEOS_FOLDER_ID=
GOOGLE_DRIVE_PAYMENTS_FOLDER_ID=
EMAIL_ENABLED=false
EMAIL_FROM="Rosetta"
EMAIL_USER=tu-correo@gmail.com
EMAIL_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
EMAIL_CLIENT_SECRET=xxxxxxxxxxxx
EMAIL_REFRESH_TOKEN=1//xxxxxxxxxxxx